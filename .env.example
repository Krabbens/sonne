# The automated installer collects these values together at startup.
# For --env-file, copy this file privately and replace the Discord values below.
# Do not add quotes, shell commands, or inline comments to values.
DISCORD_BOT_TOKEN=replace-with-your-bot-token
DISCORD_APPLICATION_ID=replace-with-application-id
DISCORD_GUILD_ID=replace-with-server-id
DISCORD_CHANNEL_ID=replace-with-channel-id
# Comma-separated numeric user IDs. Everyone listed shares files and channel history.
DISCORD_USER_IDS=replace-with-user-id,replace-with-another-user-id

# Required for the automated full installation and Discord web sign-in.
# Register PROMPT_STUDIO_URL/auth/discord/callback in OAuth2.
# This is the OAuth2 Client Secret from the same Discord application.
DISCORD_OAUTH_CLIENT_SECRET=
PROMPT_STUDIO_URL=http://localhost:9080

# configure.py generates the token and fills UID/GID when these are blank.
OPENCLAW_GATEWAY_TOKEN=
LOCAL_UID=
LOCAL_GID=

# Change only during a deliberate, verified upgrade.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.8
OLLAMA_IMAGE=ollama/ollama:0.40.0
